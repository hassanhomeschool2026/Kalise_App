# OPENAI_API_KEY: Required for OpenAI API calls.
# Users configure this via the Secrets panel in the AI Studio UI.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# OPENAI_MODEL: Model identifier for OpenAI conversational AI.
# Configurable to switch models without changing code (default: gpt-4o).
OPENAI_MODEL="gpt-4o"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ZENCORA SUPABASE PROJECT CONFIGURATION
# VITE_SUPABASE_URL: URL of your existing Zencora Supabase project
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# VITE_SUPABASE_PUBLISHABLE_KEY: Supabase publishable/anon key protected by Row Level Security
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"


